<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Play In 432</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	  WKWebView <input type="file"> on iPad may offer "Take Photo" even when
	  accept=audio/*. Without these strings, iOS can terminate the app if the
	  user taps Camera. The app does not use camera for product features;
	  non-audio files are rejected in JavaScript.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Play In 432 only imports audio files for retuning. The system file picker on iPad may show Camera — please cancel and choose an audio file from Files instead. Camera access is not required to use the app.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Play In 432 only imports audio files. Photo library access is not required. Choose audio from the Files app if the system picker appears.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Play In 432 does not record audio. Microphone access is not required for playback or retune.</string>
	<!--
	  UIBackgroundModes audio intentionally omitted (App Store Guideline 2.5.4).
	  Playback uses Web Audio API while the app is active; we do not provide
	  persistent background/lock-screen audio streams. Re-add only after
	  implementing AVAudioSession + proven background playback and a review
	  screen recording.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
		<string>https</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.playin432.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>playin432</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
