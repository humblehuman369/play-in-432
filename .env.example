# Spotify Web API (playlist metadata only — no streaming/DSP)
# 1. Create an app: https://developer.spotify.com/dashboard
# 2. Redirect URIs — must match EXACTLY (trailing slash matters).
#    Spotify does NOT allow "localhost". Use:
#      http://127.0.0.1:5173/          (local Vite)
#      https://playin432.com/           (production)
#      https://www.playin432.com/       (if you use www)
#      playin432://callback             (iOS/Android Capacitor)
# 3. Dev: open the app at http://127.0.0.1:5173/ (not localhost)
# 4. Copy Client ID here. PKCE does not need the Client Secret in the browser.
# 5. Production (Vercel): set VITE_SPOTIFY_CLIENT_ID and redeploy (build-time).

VITE_SPOTIFY_CLIENT_ID=

# Optional override (defaults: origin/ on web, playin432://callback on native)
# VITE_SPOTIFY_REDIRECT_URI=https://playin432.com/

# ── RevenueCat (native iOS / Android IAP) ───────────────────────
# Public SDK keys from app.revenuecat.com → Project → API keys
# Entitlement ID in dashboard must be: truehz_pro
# VITE_REVENUECAT_IOS_API_KEY=appl_...
# VITE_REVENUECAT_ANDROID_API_KEY=goog_...

# ── Stripe (TrueHz Pro · web $19 one-time) ──────────────────────
# Server-only (Vercel Project → Settings → Environment Variables):
#   STRIPE_SECRET_KEY=sk_test_... or sk_live_...
# Optional fixed Price (otherwise API uses price_data $19):
#   STRIPE_PRICE_ID=price_...
# Optional public site origin for Checkout redirects:
#   APP_URL=https://playin432.com
#
# Optional client-only Payment Link (skips /api if set):
# VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# If Payment Link cannot pass session_id, set (dev only — less secure):
# VITE_STRIPE_TRUST_SUCCESS_PARAM=1
